# These are examples of environment variable NAMES, not auto-loaded .env settings.
# TARGET_URL=http://localhost:5173
# HF_EMAIL=dedicated-test-admin@example.test
# HF_PASSWORD=<inject privately through your shell or CI>
# HF_TEST_ENV=disposable
# Optional installed Chromium; otherwise use Playwright's downloaded browser.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Optional role workflows require all five dedicated staff accounts.
# Admin defaults to HF_EMAIL/HF_PASSWORD only when neither override is set.
# HF_ADMIN_EMAIL=dedicated-admin@example.test
# HF_ADMIN_PASSWORD=<inject privately>
# HF_HR_EMAIL=dedicated-hr@example.test
# HF_HR_PASSWORD=<inject privately>
# HF_MANAGER_EMAIL=dedicated-manager@example.test
# HF_MANAGER_PASSWORD=<inject privately>
# HF_INTERVIEWER_EMAIL=dedicated-interviewer@example.test
# HF_INTERVIEWER_PASSWORD=<inject privately>
# HF_IT_EMAIL=dedicated-it@example.test
# HF_IT_PASSWORD=<inject privately>
# HF_MOCK_SERVICES=1  # Explicitly acknowledge isolated mock integrations.
