{
  "name": "quality-harbor-test-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QualityHarbor Test Platform: independent URL-driven Playwright API and browser regression tests",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node src/cli/run.mjs",
    "test:api": "node src/cli/run.mjs --project=hireflow-api",
    "test:ui": "node src/cli/run.mjs --project=hireflow-chromium",
    "test:safety": "node --test tests/unit/*.test.mjs tests/integration/api-guard.test.mjs",
    "typecheck": "tsc --noEmit",
    "report": "node src/cli/report.mjs",
    "check": "npm run test:unit && npm run test:integration && npm run typecheck",
    "test:smoke": "node src/cli/run.mjs --smoke",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  }
}
