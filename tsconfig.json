{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "playwright.config.ts",
    "src/**/*.ts",
    "src/**/*.mjs",
    "projects/**/*.ts"
  ]
}
